# Connexion gRPC à l'hôte rspigot
RSPIGOT_URL=http://127.0.0.1:25580
RSPIGOT_PLUGIN_NAME=ferriscraft-lobby

# Authentification individuelle FerrisKey (OAuth 2.0 Device Flow — RFC 8628)
FERRISKEY_URL=http://localhost:3333
FERRISKEY_REALM=capitainerie
FERRISKEY_CLIENT_ID=minecraft
# FERRISKEY_CLIENT_SECRET=
FERRISKEY_SCOPE="openid profile email roles"

# Pont Capitainerie (optionnel — utilise le token FerrisKey du realm "capitainerie")
# CAPITAINERIE_URL=http://localhost:4100
# CAPITAINERIE_RESOURCE=http://localhost:4100
# CAPITAINERIE_CONSOLE_URL=http://localhost:4080
# Jeton lecture-seule optionnel pour afficher l'état des agents avant qu'un joueur ne se connecte
# CAPITAINERIE_OBSERVER_TOKEN=

# Orchestrateur Kubernetes & file d'attente SheepWars (optionnel en local)
# ORCHESTRATOR_URL=http://127.0.0.1:8080
# ORCHESTRATOR_TOKEN=
# ORCHESTRATOR_BACKEND=static
# STATIC_SHEEPWARS_SERVERS=sheepwars-1=127.0.0.1:25567
# QUEUE_MIN_PLAYERS=2
# SHEEPWARS_MIN_REPLICAS=1
# SHEEPWARS_MAX_REPLICAS=5

# Redirection statique de secours vers SheepWars (utilisée si ORCHESTRATOR_URL n'est pas défini)
SHEEPWARS_HOST=sheepwars.localhost
SHEEPWARS_PORT=25565
SHEEPWARS_BACKEND=127.0.0.1:25567
# SHEEPWARS_WORLD=sheepwars

# Fichiers de configuration spatiale et de sessions FerrisKey
LOBBY_LAYOUT_PATH=lobby.json
LOBBY_SESSIONS_PATH=.sessions.json
