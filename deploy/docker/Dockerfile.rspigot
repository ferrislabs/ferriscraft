# syntax=docker/dockerfile:1
FROM rust:1.90-bookworm AS builder

ENV RUSTUP_TOOLCHAIN=stable
RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /src/rspigot
COPY --from=rspigot . .
RUN rm -f rust-toolchain.toml && cargo build --release -p rspigot

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 unzip && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/rspigot/target/release/rspigot /usr/local/bin/rspigot
COPY server/bukkit.yml server/permissions.yml server/server.properties server/spigot.yml.example server/world.zip /opt/ferriscraft/templates/lobby/
COPY server-sheepwars/bukkit.yml server-sheepwars/permissions.yml server-sheepwars/server.properties server-sheepwars/spigot.yml.example server-sheepwars/world.zi[p] /opt/ferriscraft/templates/sheepwars/
COPY deploy/docker/rspigot-entrypoint.sh /usr/local/bin/rspigot-entrypoint.sh
RUN chmod +x /usr/local/bin/rspigot-entrypoint.sh

EXPOSE 25565 25580 25581
ENTRYPOINT ["/usr/local/bin/rspigot-entrypoint.sh"]
