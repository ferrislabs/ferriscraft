# syntax=docker/dockerfile:1
FROM rust:1.90-bookworm AS builder

ENV RUSTUP_TOOLCHAIN=stable
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates/ferriscraft-protocol ./crates/ferriscraft-protocol
COPY crates/ferriscraft-orchestrator ./crates/ferriscraft-orchestrator

# Build only orchestrator + protocol without requiring rspigot path deps
RUN python3 -c 'txt = open("Cargo.toml").read(); open("Cargo.toml", "w").write("\n".join(l for l in txt.splitlines() if "rspigot-" not in l) + "\n")' \
  && sed -i 's/members = \["crates\/\*"\]/members = ["crates\/ferriscraft-protocol", "crates\/ferriscraft-orchestrator"]/' Cargo.toml \
  && cargo build --release -p ferriscraft-orchestrator

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates unzip && rm -rf /var/lib/apt/lists/*
RUN useradd --system --create-home --home-dir /app ferriscraft
WORKDIR /app

COPY --from=builder /app/target/release/ferriscraft-orchestrator /usr/local/bin/ferriscraft-orchestrator
COPY --from=builder /app/target/release/ferriscraft-map-sync /usr/local/bin/ferriscraft-map-sync
USER ferriscraft
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/ferriscraft-orchestrator"]
