# syntax=docker/dockerfile:1
FROM rust:1.90-bookworm AS builder

ENV RUSTUP_TOOLCHAIN=stable
RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

COPY --from=rspigot . /opt/minecraft/dev/rspigot
WORKDIR /opt/ferrislabs/ferriscraft
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --release -p ferriscraft-sheepwars

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
RUN useradd --system --create-home --home-dir /app ferriscraft
WORKDIR /app

COPY --from=builder /opt/ferrislabs/ferriscraft/target/release/ferriscraft-sheepwars /usr/local/bin/ferriscraft-sheepwars
RUN chown -R ferriscraft:ferriscraft /app

USER ferriscraft
ENTRYPOINT ["/usr/local/bin/ferriscraft-sheepwars"]
